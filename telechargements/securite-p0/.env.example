# Environnement Général
DJANGO_SECRET_KEY=nexora-production-super-secret-key-change-this-now!
DJANGO_DEBUG=False
ALLOWED_HOSTS=*

# Base de Données (sqlite ou postgresql)
DB_ENGINE=postgresql
DB_NAME=nexora_db
DB_USER=nexora
DB_PASSWORD=nexora_secure_password_98765
DB_HOST=postgres
DB_PORT=5432

# Cache & Message Broker
REDIS_URL=redis://redis:6379/0

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Securite NEXORA (valeurs par defaut entre parentheses, adaptees a un poste unique)
# Le poste de caisse peut appeler l'API sans jeton (liens PDF, onglets) : True.
NEXORA_CAISSE_LOCALE=True
# Origines supplementaires autorisees a appeler l'API depuis un navigateur,
# separees par des virgules. Les adresses locales et du reseau prive sont deja
# acceptees (exemple : https://caisse.mondomaine.com).
NEXORA_CORS_ORIGINES=
# Mettre True uniquement en cas de besoin : n'importe quel site web pourrait
# alors lire l'API depuis le navigateur du poste.
NEXORA_CORS_TOUT_AUTORISE=False
# Hotes acceptes lorsque DJANGO_DEBUG=False (separees par des virgules).
NEXORA_ALLOWED_HOSTS=localhost,127.0.0.1
# Tentatives de connexion autorisees par minute et par adresse.
NEXORA_THROTTLE_CONNEXION=10/min
# Encadrement des pages HTML (SAMEORIGIN). Passer a ALLOWALL seulement si une
# page HTML doit etre affichee dans un cadre d'un autre site.
NEXORA_X_FRAME_OPTIONS=SAMEORIGIN
